generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  BLOCKED
}

enum SyncOperationStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  CONFLICT
}

enum ConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  REVERSE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  DEVICE_REVOKED
}

model Company {
  id           String          @id @default(uuid())
  name         String
  legalName    String?
  code         String          @unique
  currencyCode String          @default("YER")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  branches     Branch[]
  users        User[]
  roles        Role[]
  devices      Device[]
  warehouses   Warehouse[]
  operations   SyncOperation[]
  conflicts    SyncConflict[]
  auditLogs    AuditLog[]
  settings     Setting[]

  @@index([active])
}

model Branch {
  id         String      @id @default(uuid())
  tenantId   String
  company    Company     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  code       String
  address    String?
  phone      String?
  active     Boolean     @default(true)
  users      User[]
  devices    Device[]
  warehouses Warehouse[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model User {
  id             String          @id @default(uuid())
  tenantId       String
  company        Company         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  email          String?
  phone          String?
  fullName       String
  passwordHash   String
  status         UserStatus      @default(INVITED)
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          UserRole[]
  devices        Device[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([branchId])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  company     Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Device {
  id            String           @id @default(uuid())
  tenantId      String
  company       Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  platform      String
  deviceKeyHash String
  status        DeviceStatus     @default(ACTIVE)
  lastSeenAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  operations    SyncOperation[]
  cursors       SyncCursor[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, deviceKeyHash])
  @@index([tenantId, status])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  company   Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model SyncOperation {
  id             String              @id @default(uuid())
  tenantId       String
  company        Company             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId       String
  device         Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  entityType     String
  entityId       String
  operationType  String
  payload        String              // SQLite JSON stored as String
  version        Int                 @default(1)
  idempotencyKey String
  status         SyncOperationStatus @default(PENDING)
  errorMessage   String?
  createdAt      DateTime            @default(now())
  processedAt    DateTime?
  conflict       SyncConflict?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([deviceId, createdAt])
  @@index([entityType, entityId])
}

model SyncConflict {
  id            String         @id @default(uuid())
  tenantId      String
  company       Company        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationId   String         @unique
  operation     SyncOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  localPayload  String
  remotePayload String
  status        ConflictStatus @default(OPEN)
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([tenantId, status])
}

model SyncCursor {
  id           String   @id @default(uuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  stream       String
  lastSequence BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([deviceId, stream])
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  company       Company     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId  String?
  device    Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  before    String?
  after     String?
  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

model Setting {
  id        String   @id @default(uuid())
  tenantId  String
  company   Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}
