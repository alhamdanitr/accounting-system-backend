generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  BLOCKED
}

enum SyncOperationStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  CONFLICT
}

enum ConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  REVERSE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  DEVICE_REVOKED
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  SALE_RETURN_IN
  PURCHASE_RETURN_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  INITIAL_STOCK
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
  TRANSFERRED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIALLY_PAID
  CREDIT
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIALLY_PAID
  CREDIT
  CANCELLED
  RETURNED
}

enum PaymentType {
  CASH
  CARD
  BANK_TRANSFER
  CREDIT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model Company {
  id           String          @id @default(uuid())
  name         String
  legalName    String?
  code         String          @unique
  currencyCode String          @default("YER")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  branches     Branch[]
  users        User[]
  roles        Role[]
  devices      Device[]
  warehouses   Warehouse[]
  categories   Category[]
  brands       Brand[]
  units        Unit[]
  products     Product[]
  customers    Customer[]
  suppliers    Supplier[]
  sales        Sale[]
  purchases    Purchase[]
  accounts     Account[]
  journals     JournalEntry[]
  cashboxes    Cashbox[]
  expenses     Expense[]
  operations   SyncOperation[]
  conflicts    SyncConflict[]
  auditLogs    AuditLog[]
  settings     Setting[]

  @@index([active])
}

model Branch {
  id         String      @id @default(uuid())
  tenantId   String
  company    Company     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  code       String
  address    String?
  phone      String?
  active     Boolean     @default(true)
  users      User[]
  devices    Device[]
  warehouses Warehouse[]
  sales      Sale[]
  purchases  Purchase[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model User {
  id             String          @id @default(uuid())
  tenantId       String
  company        Company         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  email          String?
  phone          String?
  fullName       String
  passwordHash   String
  status         UserStatus      @default(INVITED)
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  roles          UserRole[]
  devices        Device[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[] @relation("MovementCreator")
  sales          Sale[]          @relation("SellerUser")
  purchases      Purchase[]      @relation("BuyerUser")
  journals       JournalEntry[]  @relation("JournalCreator")
  expenses       Expense[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([branchId])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  company     Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Device {
  id            String           @id @default(uuid())
  tenantId      String
  company       Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  platform      String
  deviceKeyHash String
  status        DeviceStatus     @default(ACTIVE)
  lastSeenAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  operations    SyncOperation[]
  cursors       SyncCursor[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, deviceKeyHash])
  @@index([tenantId, status])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Warehouse {
  id             String          @id @default(uuid())
  tenantId       String
  company        Company         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name           String
  code           String
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  sales          Sale[]
  purchases      Purchase[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

model Category {
  id          String    @id @default(uuid())
  tenantId    String
  company     Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Brand {
  id        String    @id @default(uuid())
  tenantId  String
  company   Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Unit {
  id        String    @id @default(uuid())
  tenantId  String
  company   Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Product {
  id               String           @id @default(uuid())
  tenantId         String
  company          Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku              String
  barcode          String?
  arabicName       String
  englishName      String?
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitId           String?
  unit             Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  purchasePrice    Float            @default(0)
  salePrice        Float            @default(0)
  wholesalePrice   Float            @default(0)
  minimumPrice     Float            @default(0)
  taxRate          Float            @default(0)
  minimumStock     Float            @default(0)
  maximumStock     Float            @default(0)
  serialTracking   Boolean          @default(false)
  expiryTracking   Boolean          @default(false)
  active           Boolean          @default(true)
  imageUrl         String?
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  barcodes         ProductBarcode[]
  stockBalances    StockBalance[]
  stockMovements   StockMovement[]
  serialNumbers    SerialNumber[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, active])
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String   @unique
  createdAt DateTime @default(now())

  @@index([productId])
}

model StockBalance {
  id          String    @id @default(uuid())
  tenantId    String
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float     @default(0)
  reservedQty Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([tenantId])
}

model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  warehouseId  String
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Float
  balanceAfter Float
  referenceId  String?
  notes        String?
  createdById  String?
  creator      User?             @relation("MovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([tenantId, createdAt])
  @@index([warehouseId, productId])
  @@index([type])
}

model SerialNumber {
  id           String       @id @default(uuid())
  tenantId     String
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumber String       @unique
  status       SerialStatus @default(IN_STOCK)
  purchaseId   String?
  saleId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId, status])
  @@index([productId])
}

model Customer {
  id           String               @id @default(uuid())
  tenantId     String
  company      Company              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  address      String?
  creditLimit  Float                @default(0)
  balance      Float                @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  sales        Sale[]
  transactions CustomerTransaction[]

  @@index([tenantId, phone])
}

model CustomerTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([customerId])
}

model Supplier {
  id           String                @id @default(uuid())
  tenantId     String
  company      Company               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  address      String?
  balance      Float                 @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  purchases    Purchase[]
  transactions SupplierTransaction[]

  @@index([tenantId, phone])
}

model SupplierTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([supplierId])
}

model Sale {
  id            String        @id @default(uuid())
  tenantId      String
  company       Company       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId        String?
  seller        User?         @relation("SellerUser", fields: [userId], references: [id], onDelete: SetNull)
  invoiceNumber String
  status        SaleStatus    @default(CONFIRMED)
  subTotal      Float
  discount      Float         @default(0)
  taxTotal      Float         @default(0)
  grandTotal    Float
  paidAmount    Float         @default(0)
  dueAmount     Float         @default(0)
  paymentType   PaymentType   @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SaleItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([customerId])
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Float
  unitPrice  Float
  discount   Float    @default(0)
  taxRate    Float    @default(0)
  total      Float

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id            String         @id @default(uuid())
  tenantId      String
  company       Company        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouseId   String
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId        String?
  buyer         User?          @relation("BuyerUser", fields: [userId], references: [id], onDelete: SetNull)
  invoiceNumber String
  status        PurchaseStatus @default(CONFIRMED)
  subTotal      Float
  discount      Float          @default(0)
  taxTotal      Float          @default(0)
  grandTotal    Float
  paidAmount    Float          @default(0)
  dueAmount     Float          @default(0)
  paymentType   PaymentType    @default(CASH)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PurchaseItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Float
  unitPrice  Float
  discount   Float    @default(0)
  taxRate    Float    @default(0)
  total      Float

  @@index([purchaseId])
  @@index([productId])
}

model Account {
  id          String              @id @default(uuid())
  tenantId    String
  company     Company             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String              // 1010, 2010 etc.
  name        String
  type        AccountType
  parentId    String?
  parent      Account?            @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Account[]           @relation("AccountHierarchy")
  lines       JournalEntryLine[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model JournalEntry {
  id            String             @id @default(uuid())
  tenantId      String
  company       Company            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNumber   String
  reference     String?
  description   String
  status        JournalStatus      @default(POSTED)
  createdById   String?
  creator       User?              @relation("JournalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  lines         JournalEntryLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, status])
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
}

model Cashbox {
  id        String   @id @default(uuid())
  tenantId  String
  company   Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  company     Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category    String   // إيجار، كهرباء، رواتب، صيانة
  amount      Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model SyncOperation {
  id             String              @id @default(uuid())
  tenantId       String
  company        Company             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId       String
  device         Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  entityType     String
  entityId       String
  operationType  String
  payload        String
  version        Int                 @default(1)
  idempotencyKey String
  status         SyncOperationStatus @default(PENDING)
  errorMessage   String?
  createdAt      DateTime            @default(now())
  processedAt    DateTime?
  conflict       SyncConflict?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([deviceId, createdAt])
  @@index([entityType, entityId])
}

model SyncConflict {
  id            String         @id @default(uuid())
  tenantId      String
  company       Company        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationId   String         @unique
  operation     SyncOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  localPayload  String
  remotePayload String
  status        ConflictStatus @default(OPEN)
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([tenantId, status])
}

model SyncCursor {
  id           String   @id @default(uuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  stream       String
  lastSequence BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([deviceId, stream])
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  company   Company     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId  String?
  device    Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  before    String?
  after     String?
  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

model Setting {
  id        String   @id @default(uuid())
  tenantId  String
  company   Company  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}
